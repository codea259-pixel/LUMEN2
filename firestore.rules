rules_version = '2';

// Security rules for Bose Academy on Firebase.
// Paste this whole file into Firebase console > Firestore Database > Rules, then click Publish.
// Before publishing, replace PASTE_OWNER_GMAIL with the Google account (Gmail) that owns the site.
// Only that Google account, signed in with "Continue with Google", becomes the owner.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'PASTE_OWNER_GMAIL' && request.auth.token.email_verified == true; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return isOwner() || (hasProfile() && me().locked != true); }
    function isTeacher() { return isOwner() || (active() && me().role in ['teacher', 'school_admin']); }
    function isMod() { return isOwner() || (active() && me().role == 'teacher' && me().verified == true); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // the list field gained or lost exactly the signed-in user, nothing else
    function toggledSelf(f) {
      let after = request.resource.data.get(f, []).toSet();
      let before = resource.data.get(f, []).toSet();
      return after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
    }
    function addedSelf(f) {
      let after = request.resource.data.get(f, []).toSet();
      let before = resource.data.get(f, []).toSet();
      return after.difference(before) == [request.auth.uid].toSet() && before.difference(after).size() == 0;
    }
    function removedSelf(f) {
      let after = request.resource.data.get(f, []).toSet();
      let before = resource.data.get(f, []).toSet();
      return before.difference(after) == [request.auth.uid].toSet() && after.difference(before).size() == 0;
    }
    // A parent: signed in with the verified email that a learner under 13 gave at sign-up (kept in private/{uid})
    function isParentOf(uid) {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.get('email', '') != ''
        && exists(/databases/$(db)/documents/private/$(uid))
        && get(/databases/$(db)/documents/private/$(uid)).data.get('parentEmail', '') == request.auth.token.email.lower();
    }
    function parentSaidYes(uid) {
      return exists(/databases/$(db)/documents/consents/$(uid)) && get(/databases/$(db)/documents/consents/$(uid)).data.decision == 'yes';
    }
    // Learners under 13 who signed up themselves save to their account only after a parent says yes (teacher-made logins: the school's OK)
    function kidOK() { return me().get('under13', false) != true || me().get('managedBy', '') != '' || parentSaidYes(request.auth.uid); }
    function okText(f, lo, hi) { return request.resource.data[f] is string && request.resource.data[f].size() >= lo && request.resource.data[f].size() <= hi; }
    // Rude words are refused here too, so getting around the page's own filter doesn't help
    function polite(f) { return !request.resource.data[f].lower().matches('(?s).*\\b(fuck\\w*|shit\\w*|bitch\\w*|bastard|asshole|dick|dicks|piss|slut|whore|retard\\w*|nigg\\w*|fag\\w*|cunt|kys|kill yourself|stupid|idiot|dumb|moron|hate you|shut up)\\b.*'); }
    // Posting speed: each post or reply also stamps limits/{uid}, which allows one stamp every 20 seconds
    function stamped() { return getAfter(/databases/$(db)/documents/limits/$(request.auth.uid)).data.post == request.time; }

    // A class leaderboard row can only grow as fast as real learning: the row carries the server's time, and XP, weekly XP
    // and stars may rise by a little plus a few points a second since the last save (the first save is capped)
    function boardFair() {
      let d = request.resource.data;
      let st = d.get('st', 0);
      return d.ts == request.time && d.xp <= 1000000 && d.wx <= 20000 && st <= 5000
        && (resource == null || !(resource.data.ts is timestamp)
          ? (d.xp <= 300000 && st <= 1500)
          : (d.xp - resource.data.xp <= 300 + (request.time.toMillis() - resource.data.ts.toMillis()) / 1000 * 4
             && (d.w != resource.data.w || d.wx - resource.data.wx <= 300 + (request.time.toMillis() - resource.data.ts.toMillis()) / 1000 * 4)
             && st - resource.data.get('st', 0) <= 9 + (request.time.toMillis() - resource.data.ts.toMillis()) / 10000));
    }

    // One stamp per person: when they last posted or replied
    match /limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['post'])
        && request.resource.data.post == request.time
        && (resource == null || request.time > resource.data.post + duration.value(20, 's'));
    }

    // Site settings: anyone can read; only the owner can change them (the owner also claims the site here once)
    match /config/site {
      allow read: if true;
      allow write: if isOwner();
    }

    // Public profiles: username, display name, role. Nobody can make themselves owner, verified or unlocked.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher() || isParentOf(uid));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['student', 'parent', 'teacher']
        && request.resource.data.verified == false && request.resource.data.locked == false
        && request.resource.data.get('memberUntil', 0) == 0
        && okText('display', 2, 20) && polite('display') && okText('username', 3, 20) && polite('username')
        && (request.resource.data.get('managedBy', '') == ''
            || get(/databases/$(db)/documents/config/site).data.get('ownerUid', '') == request.resource.data.managedBy
            || get(/databases/$(db)/documents/users/$(request.resource.data.managedBy)).data.role in ['teacher', 'school_admin']);
      allow update: if isOwner()
        || (request.auth.uid == uid && active() && changedOnly(['display']) && okText('display', 2, 20) && polite('display'));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || isParentOf(uid));
    }

    // Private details (email, a parent's email): the person, the owner, and the parent whose email it is.
    // A learner can change the parent email only until a parent has said yes.
    match /private/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner()
        || (request.auth.token.email_verified == true && resource.data.get('parentEmail', '') != ''
            && resource.data.get('parentEmail', '') == request.auth.token.get('email', '').lower()));
      allow create: if signedIn() && (request.auth.uid == uid || isOwner());
      allow update: if signedIn() && (isOwner() || (request.auth.uid == uid
        && (request.resource.data.get('parentEmail', '') == resource.data.get('parentEmail', '') || !parentSaidYes(uid))));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || isParentOf(uid));
    }

    // A parent's answer for a learner under 13. Only the parent writes it, signed in with the emailed link.
    match /consents/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || isParentOf(uid));
      allow create, update: if isParentOf(uid)
        && request.resource.data.keys().hasOnly(['decision', 'parentUid', 'parentEmail', 'at', 'method', 'policy'])
        && request.resource.data.decision == 'yes' && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.parentEmail == request.auth.token.email.lower() && request.resource.data.at is int;
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || isParentOf(uid));
    }

    // Saved progress: the learner writes their own (under 13: once a parent says yes); their teachers (listed in readers),
    // their parent and the owner can read it
    match /state/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || request.auth.uid in resource.data.get('readers', []) || isParentOf(uid));
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('json', '').size() < 400000
        && (kidOK() || request.resource.data.get('json', '{}') == '{}'
            || (resource != null && request.resource.data.get('json', '') == resource.data.get('json', '')));
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner() || isParentOf(uid));
    }

    // Classes: the teacher manages them; students can only add themselves with a join code
    match /classes/{cid} {
      function cls() { return get(/databases/$(db)/documents/classes/$(cid)).data; }
      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.members || isOwner());
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && request.resource.data.members.size() == 0
        && request.resource.data.get('memberUntil', 0) == 0;
      // Teachers manage their classes, but only the Owner can switch on a class membership (memberUntil)
      allow update: if signedIn() && (
        (resource.data.teacherId == request.auth.uid && isTeacher() && request.resource.data.get('memberUntil', 0) == resource.data.get('memberUntil', 0)) || isOwner()
        || (active() && me().role == 'student' && changedOnly(['members']) && addedSelf('members'))
        || (signedIn() && changedOnly(['members']) && removedSelf('members')));
      allow delete: if signedIn() && (resource.data.teacherId == request.auth.uid || isOwner());

      match /assignments/{aid} {
        allow read: if signedIn() && (cls().teacherId == request.auth.uid || request.auth.uid in cls().members || isOwner());
        allow write: if signedIn() && (cls().teacherId == request.auth.uid || isOwner());
      }

      // Classwork, quizzes and tests: students in the class read the questions; only the teacher writes them
      match /tests/{tid} {
        allow read: if signedIn() && (cls().teacherId == request.auth.uid || request.auth.uid in cls().members || isOwner());
        allow write: if signedIn() && (cls().teacherId == request.auth.uid || isOwner());

        // The answer key and draft grades: the teacher only
        match /key/{k} {
          allow read, write: if signedIn() && (cls().teacherId == request.auth.uid || isOwner());
        }

        // A student's answers. Students write only their own, only until they turn it in, and never their score.
        match /subs/{uid} {
          allow read: if signedIn() && (request.auth.uid == uid || cls().teacherId == request.auth.uid || isOwner());
          allow create: if signedIn() && (cls().teacherId == request.auth.uid || isOwner()) && request.resource.data.keys().hasOnly(['result']);
          allow create: if signedIn() && request.auth.uid == uid && active() && request.auth.uid in cls().members
            && request.resource.data.keys().hasOnly(['answers', 'started', 'submitted'])
            && request.resource.data.submitted == 0 && request.resource.data.answers.size() < 100000;
          allow update: if signedIn() && (
            cls().teacherId == request.auth.uid || isOwner()
            || (request.auth.uid == uid && active() && request.auth.uid in cls().members
                && resource.data.get('submitted', 0) == 0
                && changedOnly(['answers', 'submitted', 'started'])
                && (resource.data.get('started', 0) == 0 || request.resource.data.get('started', 0) == resource.data.get('started', 0))
                && request.resource.data.get('answers', '').size() < 100000));
          allow delete: if signedIn() && (cls().teacherId == request.auth.uid || isOwner());
        }
      }

      // Weekly class leaderboard: each learner writes only their own row (name, XP, this week's XP, hero look)
      match /board/{uid} {
        allow read: if signedIn() && (cls().teacherId == request.auth.uid || request.auth.uid in cls().members || isOwner());
        allow create, update: if signedIn() && request.auth.uid == uid && active() && request.auth.uid in cls().members
          && request.resource.data.keys().hasOnly(['n', 'xp', 'w', 'wx', 'hero', 'ts', 'st'])
          && polite('n') && boardFair()
          && (!('st' in request.resource.data) || (request.resource.data.st is int && request.resource.data.st >= 0 && request.resource.data.st <= 100000))
          && request.resource.data.n is string && request.resource.data.n.size() <= 20
          && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000000
          && request.resource.data.wx is int && request.resource.data.wx >= 0 && request.resource.data.wx <= 1000000
          && request.resource.data.w is string && request.resource.data.w.size() <= 10
          && request.resource.data.hero is string && request.resource.data.hero.size() <= 400;
        allow delete: if signedIn() && (request.auth.uid == uid || cls().teacherId == request.auth.uid || isOwner());
      }

      // Goblin Gate maps shared with the class. Class members and the teacher add their own (the name is two numbers for two word
      // lists, so there's no free text, and the author's name must be their display name); anyone in the class can like a map
      // (only themselves) or count one play; the author or the teacher removes it.
      match /maps/{mid} {
        function inClass() { return request.auth.uid in cls().members || cls().teacherId == request.auth.uid; }
        allow read: if signedIn() && (inClass() || isOwner());
        allow create: if signedIn() && active() && inClass()
          && request.resource.data.keys().hasOnly(['uid', 'by', 'na', 'nb', 'th', 'w', 'd', 'b', 'road', 'pads', 'likes', 'plays', 'ts'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.by == me().display
          && request.resource.data.na is int && request.resource.data.na >= 0 && request.resource.data.na <= 15
          && request.resource.data.nb is int && request.resource.data.nb >= 0 && request.resource.data.nb <= 15
          && request.resource.data.th in ['valley', 'frozen', 'crystal', 'swamp', 'lava', 'sky', 'fortress']
          && request.resource.data.w is int && request.resource.data.w >= 5 && request.resource.data.w <= 10
          && request.resource.data.d is int && request.resource.data.d >= 0 && request.resource.data.d <= 2
          && request.resource.data.b is bool
          && request.resource.data.road is string && request.resource.data.road.size() >= 30 && request.resource.data.road.size() <= 270 && request.resource.data.road.matches('[0-9a-z]+')
          && request.resource.data.pads is string && request.resource.data.pads.size() >= 6 && request.resource.data.pads.size() <= 16 && request.resource.data.pads.matches('[0-9a-z]+')
          && request.resource.data.likes == [] && request.resource.data.plays == 0 && request.resource.data.ts is int;
        allow update: if signedIn() && active() && inClass() && (
          (changedOnly(['likes']) && toggledSelf('likes'))
          || (changedOnly(['plays']) && request.resource.data.plays == resource.data.plays + 1));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || cls().teacherId == request.auth.uid || isOwner());
      }

      // Bonus gems from the teacher. A learner can only mark their own gift as claimed, once.
      match /awards/{aid} {
        allow read: if signedIn() && (cls().teacherId == request.auth.uid || isOwner() || resource.data.uid == request.auth.uid);
        allow create: if signedIn() && (cls().teacherId == request.auth.uid || isOwner())
          && request.resource.data.gems is int && request.resource.data.gems >= 1 && request.resource.data.gems <= 20
          && request.resource.data.claimed == false && request.resource.data.uid in cls().members
          // the Turtle is an exclusive pet: only the Owner can put one in a gift
          && (!('pet' in request.resource.data) || (isOwner() && request.resource.data.pet == 'p_turtle'));
        allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.claimed == false
          && changedOnly(['claimed']) && request.resource.data.claimed == true;
        allow delete: if signedIn() && (cls().teacherId == request.auth.uid || isOwner());
      }
    }
    // Question versions made on the site: teachers read shared versions and their own; only the author or the owner changes one
    match /qvers/{vid} {
      allow read: if isTeacher() && (resource.data.shared == true || resource.data.ownerId == request.auth.uid || isOwner());
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid && request.resource.data.json.size() < 160000;
      allow update: if isTeacher() && (resource.data.ownerId == request.auth.uid || isOwner())
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.json.size() < 160000;
      allow delete: if isTeacher() && (resource.data.ownerId == request.auth.uid || isOwner());
    }
    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }

    // Community posts and replies
    // Authors can delete their own posts and replies (California's law for minors: Business and Professions Code 22581)
    match /posts/{pid} {
      allow read: if active() && (resource.data.hidden == false || isMod() || resource.data.authorId == request.auth.uid);
      allow create: if active() && me().get('under13', false) != true && request.resource.data.authorId == request.auth.uid
        && request.resource.data.hidden == false && request.resource.data.pinned == false && request.resource.data.locked == false
        && request.resource.data.votes.size() == 0 && request.resource.data.reports.size() == 0
        && okText('title', 5, 120) && okText('body', 10, 2000) && polite('title') && polite('body')
        && request.resource.data.authorName == me().display && stamped();
      allow update: if isMod() || (active() && (
        (changedOnly(['votes']) && toggledSelf('votes'))
        || (changedOnly(['reports']) && addedSelf('reports'))
        || (changedOnly(['reports', 'hidden']) && addedSelf('reports') && request.resource.data.hidden == true && request.resource.data.reports.size() >= 3)));
      allow delete: if isMod() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /replies/{rid} {
      allow read: if active() && (resource.data.hidden == false || isMod() || resource.data.authorId == request.auth.uid);
      allow create: if active() && me().get('under13', false) != true && request.resource.data.authorId == request.auth.uid
        && request.resource.data.hidden == false && request.resource.data.reports.size() == 0 && okText('body', 2, 2000) && polite('body')
        && request.resource.data.authorName == me().display && stamped()
        && get(/databases/$(db)/documents/posts/$(request.resource.data.postId)).data.locked != true;
      allow update: if isMod() || (active() && (
        (changedOnly(['reports']) && addedSelf('reports'))
        || (changedOnly(['reports', 'hidden']) && addedSelf('reports') && request.resource.data.hidden == true && request.resource.data.reports.size() >= 3)));
      allow delete: if isMod() || (signedIn() && (resource.data.authorId == request.auth.uid
        || (exists(/databases/$(db)/documents/posts/$(resource.data.postId))
            && get(/databases/$(db)/documents/posts/$(resource.data.postId)).data.authorId == request.auth.uid)));
    }

    // Study groups: anyone signed in can join or leave
    match /groups/{gid} {
      allow read: if active();
      allow create: if active() && me().get('under13', false) != true && request.resource.data.members == [request.auth.uid] && okText('name', 3, 40) && polite('name');
      allow update: if active() && changedOnly(['members', 'memberNames']) && toggledSelf('members');
    }

    // Certificates: anyone with the ID can verify one; people create only their own
    match /certs/{id} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isOwner() || isParentOf(resource.data.uid));
      allow create: if active() && kidOK() && request.resource.data.uid == request.auth.uid && okText('name', 2, 40) && polite('name');
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner() || isParentOf(resource.data.uid));
    }

    // Public Impact counters (only ever go up)
    match /stats/global {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.get('answered', 0) >= resource.data.get('answered', 0)
        && request.resource.data.get('secs', 0) >= resource.data.get('secs', 0)
        && request.resource.data.get('learners', 0) >= resource.data.get('learners', 0);
    }
  }
}
